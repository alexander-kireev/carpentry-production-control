POSTGRES_DB=carpentry_control
POSTGRES_USER=carpentry
POSTGRES_PASSWORD=replace-with-a-local-development-password
DJANGO_SECRET_KEY=replace-with-a-local-development-only-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ADMIN_REGISTRATION_ACTIVATION_CODE=replace-with-a-development-activation-code
ADMIN_REGISTRATION_IP_HMAC_KEY=replace-with-an-independent-development-hmac-key
ADMIN_REGISTRATION_IP_HMAC_KEY_VERSION=1
INVITATION_DELIVERY_MODE=memory
INVITATION_ENVIRONMENT=local
INVITATION_PUBLIC_ORIGIN=http://127.0.0.1:8000
INVITATION_SMTP_HOST=smtp.resend.com
INVITATION_SMTP_PORT=587
INVITATION_SMTP_USERNAME=resend
INVITATION_FROM_EMAIL=workshop@alder-and-green.co.uk
INVITATION_SMTP_API_KEY=replace-with-the-environment-held-resend-api-key
INVITATION_SMTP_TIMEOUT_SECONDS=10
INVITATION_RECIPIENT_ALLOWLIST=
